# cp .env.example .env 후 사용. 비밀 값은 비워 두고 .env 에만 채운다 (.env 는 gitignore 대상).

# --- 서버 ---
APP_ENV=dev                     # dev | test | prod
LOG_LEVEL=INFO
LOG_QUERY_TEXT=false
EXPOSE_DOCS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_SECRET=change-me-32bytes-min       # JWT HS256, 32바이트 이상. prod 에서 기본값이면 기동 거부
AUTH_TOKEN_TTL_SECONDS=28800
SEED_ON_START=true
DATA_DIR=/data
INSTITUTIONS_FILE=/app/config/institutions.yaml
USERS_FILE=/app/config/users.yaml

# --- 검색 엔진 ---
QDRANT_URL=http://qdrant:6333
OPENSEARCH_URL=http://opensearch:9200
KEYWORD_ANALYZER=korean         # korean | standard
SEARCH_ENGINE_TIMEOUT_MS=2000

# --- 임베딩 ---
EMBEDDING_PROVIDER=local        # local | openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- 답변 ---
ANSWER_PROVIDER=fake            # fake | openai | claude
OPENAI_CHAT_MODEL=              # 키 없이 구현해 미확인. GET /v1/models 로 확인 후 기록 (ADR-007). openai provider 면 필수
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
ANSWER_MAX_ATTEMPTS=2
ANSWER_TIMEOUT_SECONDS=30

# --- 캐시·한도 ---
CACHE_EMBED_TTL_SECONDS=3600
CACHE_RETRIEVAL_TTL_SECONDS=300
CACHE_ANSWER_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MINUTE=30      # /search + /answers 합산, 사용자당
RATE_LIMIT_ANSWERS_PER_MINUTE=10    # /answers 단독
RATE_LIMIT_UPLOAD_PER_HOUR=20
RERANK_ENABLED=false
